{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MazeProof structured maze v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "mazeproof.maze/1"
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 250
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 250
    },
    "horizontalWalls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 251,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 251,
        "items": {
          "type": "boolean"
        }
      }
    },
    "verticalWalls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 251,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 251,
        "items": {
          "type": "boolean"
        }
      }
    },
    "entrance": {
      "type": "object",
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "col": {
          "type": "integer",
          "minimum": 0
        },
        "side": {
          "enum": [
            "N",
            "E",
            "S",
            "W"
          ]
        }
      },
      "required": [
        "row",
        "col",
        "side"
      ],
      "additionalProperties": false
    },
    "exit": {
      "type": "object",
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "col": {
          "type": "integer",
          "minimum": 0
        },
        "side": {
          "enum": [
            "N",
            "E",
            "S",
            "W"
          ]
        }
      },
      "required": [
        "row",
        "col",
        "side"
      ],
      "additionalProperties": false
    },
    "route": {
      "type": "array",
      "maxItems": 62500,
      "items": {
        "type": "object",
        "properties": {
          "row": {
            "type": "integer",
            "minimum": 0
          },
          "col": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "row",
          "col"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "width",
    "height",
    "horizontalWalls",
    "verticalWalls",
    "entrance",
    "exit"
  ]
}
